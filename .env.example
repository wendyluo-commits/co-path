# ─── Required ──────────────────────────────────────────────────────────────────

# OpenAI API key — used by all /api/reading calls.
OPENAI_API_KEY=sk-...

# Optional model override. Defaults to gpt-4o-mini.
MODEL_NAME=gpt-4o-mini

# Required in production: HMAC secret for signing fair-shuffle session tokens.
# Generate with:  openssl rand -hex 32
# If unset in dev, an ephemeral per-process random secret is used (sessions
# don't survive restart).
SESSION_SECRET=replace-me-with-32-plus-random-bytes

# ─── Optional ──────────────────────────────────────────────────────────────────

# Public app name shown in the UI.
NEXT_PUBLIC_APP_NAME=AI Tarot

# ─── Feedback email (Resend) ───────────────────────────────────────────────────
# When set, /api/feedback sends each submission as an email to FEEDBACK_EMAIL_TO.
# When unset, feedback is silently accepted but only stored in the user's
# localStorage (developer can't see it). Get a key at https://resend.com.
# RESEND_API_KEY=re_...
# FEEDBACK_EMAIL_TO=you@example.com
# Optional sender. Defaults to feedback@resend.dev which works without
# verifying a custom domain on Resend.
# FEEDBACK_EMAIL_FROM=feedback@resend.dev
